{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build glib",
            "type": "shell",
            "command": "ruby extconf.rb && make && cp ext/glib2/glib2.so lib",
            "options": {
                "cwd": "${workspaceFolder}/glib2"
            },
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}